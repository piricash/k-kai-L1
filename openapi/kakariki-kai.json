{
  "openapi": "3.0.4",
  "info": {
    "title": "KakarikiKai.WebAPI",
    "version": "1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "KakarikiKai.WebAPI"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/menu/next-week": {
      "get": {
        "tags": [
          "KakarikiKai.WebAPI"
        ],
        "operationId": "GetNextWeekMenu",
        "parameters": [
          {
            "name": "weekCommencing",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeeklyMenuResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chef/daily-service/{serviceDate}": {
      "get": {
        "tags": [
          "KakarikiKai.WebAPI"
        ],
        "operationId": "GetChefDailyService",
        "parameters": [
          {
            "name": "serviceDate",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChefDailyServiceResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChefBookingResponse": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "nullable": true
          },
          "requestedDietaryOptions": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ChefDailyServiceResponse": {
        "type": "object",
        "properties": {
          "serviceDate": {
            "type": "string",
            "format": "date"
          },
          "mealName": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "isFree": {
            "type": "boolean"
          },
          "bookingCount": {
            "type": "integer",
            "format": "int32"
          },
          "bookings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChefBookingResponse"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MenuDayResponse": {
        "type": "object",
        "properties": {
          "serviceDate": {
            "type": "string",
            "format": "date"
          },
          "mealName": {
            "type": "string",
            "nullable": true
          },
          "mealDescription": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "isFree": {
            "type": "boolean"
          },
          "dietaryConfiguration": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "WeeklyMenuResponse": {
        "type": "object",
        "properties": {
          "weekCommencing": {
            "type": "string",
            "format": "date"
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuDayResponse"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "KindeBearer": {
        "type": "http",
        "description": "Kinde access token for the configured API audience.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "tags": [
    {
      "name": "KakarikiKai.WebAPI"
    }
  ]
}